<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1"
            fx:controller="app.controllers.RequestFuelController"
            stylesheets="@../css/styles.css">

    <top>
        <VBox styleClass="header" alignment="CENTER">
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10 0 10 0;">
                <Text text="⛽ Request Fuel" style="-fx-font-weight: bold; -fx-font-size: 28; -fx-fill: white;" />
                <Button onAction="#onLogout" text="🚪 Logout" styleClass="btn-secondary"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.3);" />
            </HBox>
            <Label text="Submit your fuel request and we'll notify you when approved" styleClass="header-subtitle">
                <padding>
                    <Insets bottom="15.0" />
                </padding>
            </Label>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="25" style="-fx-padding: 30;">

                <!-- Main Request Card -->
                <VBox spacing="20" styleClass="card" style="-fx-padding: 30;">

                    <!-- Vehicle Selection Section -->
                    <VBox spacing="15">
                        <Label text="🚗 Vehicle Information" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #1e40af;" />

                        <HBox spacing="20" alignment="TOP_LEFT">
                            <!-- Dropdown Selection -->
                            <VBox spacing="15" style="-fx-pref-width: 250;">
                                <VBox spacing="8">
                                    <Label text="Car Make" styleClass="form-label" />
                                    <ComboBox fx:id="cbMake" styleClass="combo-box" />
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Car Model" styleClass="form-label" />
                                    <ComboBox fx:id="cbModel" styleClass="combo-box" />
                                </VBox>
                            </VBox>

                            <!-- Custom Car Entry -->
                            <VBox spacing="15" style="-fx-pref-width: 300;">
                                <VBox spacing="8">
                                    <Label text="🔧 Or Enter Custom Car" styleClass="form-label" />
                                    <TextField fx:id="tfCarName" promptText="Enter your car model" styleClass="text-field" />
                                </VBox>

                                <HBox spacing="10">
                                    <Button text="➕ Add Car" onAction="#onAddCar" styleClass="btn-secondary" />
                                    <Button text="🗑️ Clear" onAction="#onClearCarInfo" styleClass="btn-secondary" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Fuel Details Section -->
                    <VBox spacing="15">
                        <Label text="⛽ Fuel Details" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #1e40af;" />

                        <HBox spacing="30" alignment="CENTER_LEFT">
                            <VBox spacing="8" style="-fx-pref-width: 250;">
                                <Label text="Fuel Capacity (Liters)" styleClass="form-label" />
                                <TextField fx:id="tfFuelCapacity" promptText="Enter fuel capacity" styleClass="text-field" />
                            </VBox>

                            <VBox spacing="8" style="-fx-pref-width: 250;">
                                <Label text="💰 Current Price" styleClass="form-label" />
                                <Text fx:id="txtPriceInfo" style="-fx-font-size: 14; -fx-fill: #1e40af; -fx-font-weight: bold;" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Action Buttons -->
                    <VBox spacing="15" alignment="CENTER">
                        <Button onAction="#onRequestFuel" text="📨 Submit Fuel Request" styleClass="btn-primary"
                                style="-fx-pref-width: 300; -fx-font-size: 16;" />

                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="btnRefreshPrices" text="🔄 Refresh Prices" styleClass="btn-secondary" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Details & Status Section -->
                <VBox spacing="15" styleClass="card" style="-fx-padding: 25;">
                    <Label text="📋 Request Details and Status" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #1e40af;" />
                    <TextArea fx:id="taDetails" prefRowCount="8" styleClass="text-area"
                              promptText="Your request details and status will appear here..." />
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>