<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.controllers.ForgotController"
      stylesheets="@../css/styles.css">

    <fx:include source="brand-panel.fxml" />

    <StackPane styleClass="auth-side" HBox.hgrow="ALWAYS">
        <VBox styleClass="auth-form" maxWidth="380" alignment="CENTER_LEFT">

            <VBox spacing="6">
                <Label text="Reset your password" styleClass="h1" />
                <Label text="Enter your username or email and choose a new password." styleClass="subtitle" wrapText="true" />
            </VBox>

            <VBox spacing="6">
                <Label text="Username or email" styleClass="field-label" />
                <HBox styleClass="input-group">
                    <FontIcon iconLiteral="mdi2a-account-outline" />
                    <TextField fx:id="txtUsernameOrEmail" promptText="Username or email" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <VBox spacing="6">
                <Label text="New password" styleClass="field-label" />
                <HBox styleClass="input-group">
                    <FontIcon iconLiteral="mdi2l-lock-outline" />
                    <PasswordField fx:id="txtNewPassword" promptText="At least 6 characters" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <VBox spacing="6">
                <Label text="Confirm new password" styleClass="field-label" />
                <HBox styleClass="input-group">
                    <FontIcon iconLiteral="mdi2l-lock-check-outline" />
                    <PasswordField fx:id="txtConfirmPassword" promptText="Repeat new password" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <Label fx:id="lblMessage" visible="false" managed="false" />

            <Button text="Reset password" onAction="#onReset" defaultButton="true" styleClass="primary, block" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="mdi2l-lock-reset" /></graphic>
            </Button>

            <HBox alignment="CENTER">
                <Hyperlink text="Back to sign in" onAction="#onBack" styleClass="link">
                    <graphic><FontIcon iconLiteral="mdi2a-arrow-left" /></graphic>
                </Hyperlink>
            </HBox>
        </VBox>
    </StackPane>
</HBox>
