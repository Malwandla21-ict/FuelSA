<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1"
      fx:controller="app.controllers.ForgotController"
      alignment="CENTER" spacing="20"
      stylesheets="@../css/styles.css"
      style="-fx-background-color: linear-gradient(to bottom right, #1e40af, #3b82f6); -fx-padding: 40;">

    <VBox alignment="CENTER" spacing="25" styleClass="login-container">
        <!-- Header -->
        <VBox alignment="CENTER" spacing="8">
            <Text text="🔐 Reset Your Password" style="-fx-font-weight: bold; -fx-font-size: 24; -fx-fill: #1e40af;" />
            <Text text="Enter your details to reset your password" style="-fx-font-size: 14; -fx-fill: #6b7280;" />
        </VBox>

        <!-- Form -->
        <VBox alignment="CENTER_LEFT" spacing="15" style="-fx-pref-width: 320;">
            <!-- Username/Email Field -->
            <VBox spacing="5">
                <Label text="Username or Email" styleClass="form-label" />
                <TextField fx:id="txtUsernameOrEmail" promptText="Enter your username or email" styleClass="text-field" />
            </VBox>

            <!-- New Password Field -->
            <VBox spacing="5">
                <Label text="New Password" styleClass="form-label" />
                <PasswordField fx:id="txtNewPassword" promptText="Enter new password" styleClass="password-field" />
            </VBox>

            <!-- Confirm Password Field -->
            <VBox spacing="5">
                <Label text="Confirm Password" styleClass="form-label" />
                <PasswordField fx:id="txtConfirmPassword" promptText="Confirm new password" styleClass="password-field" />
            </VBox>

            <!-- Message Display -->
            <Text fx:id="txtMessage" wrappingWidth="320" style="-fx-font-size: 13; -fx-fill: #dc2626;" />

            <!-- Action Buttons -->
            <VBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <Button text="🔄 Reset Password" onAction="#onReset" styleClass="btn-primary"
                        style="-fx-pref-width: 320; -fx-font-size: 14;" />
                <Button text="← Back to Login" onAction="#onBack" styleClass="btn-secondary"
                        style="-fx-pref-width: 320;" />
            </VBox>
        </VBox>
    </VBox>
</VBox>