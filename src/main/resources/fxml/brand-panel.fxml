<?xml version="1.0" encoding="UTF-8"?>

<!-- Left-hand brand panel shared by the customer sign-in screens -->

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="brand-panel" minWidth="440" prefWidth="460" maxWidth="460">

    <HBox alignment="CENTER_LEFT" spacing="14">
        <StackPane styleClass="brand-mark">
            <FontIcon iconLiteral="mdi2g-gas-station" />
        </StackPane>
        <Label text="FuelSA" styleClass="brand-name" />
    </HBox>

    <Region VBox.vgrow="ALWAYS" />

    <VBox spacing="14">
        <Label text="Fuel delivered to your door." styleClass="brand-headline" wrapText="true" />
        <Label text="Request fuel for your car in a few clicks and get notified as soon as it is approved."
               styleClass="brand-tagline" wrapText="true" />
    </VBox>

    <VBox spacing="16">
        <Label text="Save your car once, reorder in seconds" styleClass="brand-feature">
            <graphic><FontIcon iconLiteral="mdi2c-car-outline" /></graphic>
        </Label>
        <Label text="Know the cost before you request" styleClass="brand-feature">
            <graphic><FontIcon iconLiteral="mdi2c-calculator-variant-outline" /></graphic>
        </Label>
        <Label text="SMS updates when your request is reviewed" styleClass="brand-feature">
            <graphic><FontIcon iconLiteral="mdi2m-message-text-outline" /></graphic>
        </Label>
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <Label text="© FuelSA · Secure sign-in" styleClass="brand-footer" />
</VBox>
