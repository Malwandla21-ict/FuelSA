<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.controllers.AdminDashboardController"
            stylesheets="@../css/styles.css">

    <left>
        <fx:include fx:id="sidebar" source="admin-sidebar.fxml" />
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox styleClass="page">

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="Dashboard" styleClass="h1" />
                        <Label text="A quick look at FuelSA activity." styleClass="subtitle" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnReviewPending" text="Review pending" onAction="#handlePendingRequests" styleClass="primary">
                        <graphic><FontIcon iconLiteral="mdi2c-clipboard-check-outline" /></graphic>
                    </Button>
                </HBox>

                <!-- Stat cards -->
                <HBox spacing="18">
                    <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <StackPane styleClass="stat-icon, blue"><FontIcon iconLiteral="mdi2a-account-group-outline" /></StackPane>
                        <VBox spacing="2">
                            <Label text="Customers" styleClass="stat-label" />
                            <Label fx:id="totalUsersLabel" text="0" styleClass="stat-value" />
                            <Label text="Registered accounts" styleClass="stat-caption" />
                        </VBox>
                    </HBox>
                    <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <StackPane styleClass="stat-icon, amber"><FontIcon iconLiteral="mdi2c-clock-outline" /></StackPane>
                        <VBox spacing="2">
                            <Label text="Pending" styleClass="stat-label" />
                            <Label fx:id="pendingRequestsLabel" text="0" styleClass="stat-value" />
                            <Label text="Awaiting review" styleClass="stat-caption" />
                        </VBox>
                    </HBox>
                    <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <StackPane styleClass="stat-icon, green"><FontIcon iconLiteral="mdi2c-cash-multiple" /></StackPane>
                        <VBox spacing="2">
                            <Label text="Total purchases" styleClass="stat-label" />
                            <Label fx:id="totalPurchasesLabel" text="R0.00" styleClass="stat-value" />
                            <Label text="Approved requests" styleClass="stat-caption" />
                        </VBox>
                    </HBox>
                    <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <StackPane styleClass="stat-icon, violet"><FontIcon iconLiteral="mdi2t-trending-up" /></StackPane>
                        <VBox spacing="2">
                            <Label text="Profit" styleClass="stat-label" />
                            <Label fx:id="profitLabel" text="R0.00" styleClass="stat-value" />
                            <Label text="15% margin" styleClass="stat-caption" />
                        </VBox>
                    </HBox>
                </HBox>

                <HBox spacing="18">
                    <VBox styleClass="card" spacing="4" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Latest requests" styleClass="card-title">
                                <graphic><FontIcon iconLiteral="mdi2f-format-list-bulleted" /></graphic>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="View all" onAction="#handleRequestHistory" styleClass="ghost">
                                <graphic><FontIcon iconLiteral="mdi2a-arrow-right" /></graphic>
                            </Button>
                        </HBox>
                        <VBox fx:id="recentList" />
                    </VBox>

                    <VBox styleClass="card" minWidth="300" prefWidth="320" maxWidth="340">
                        <Label text="Requests by status" styleClass="card-title">
                            <graphic><FontIcon iconLiteral="mdi2c-chart-donut" /></graphic>
                        </Label>
                        <VBox fx:id="statusBox" spacing="18" />
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
