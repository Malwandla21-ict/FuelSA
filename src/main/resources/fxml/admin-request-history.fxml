<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.controllers.AdminRequestHistoryController"
            stylesheets="@../css/styles.css">

    <left>
        <fx:include fx:id="sidebar" source="admin-sidebar.fxml" />
    </left>

    <center>
        <VBox styleClass="page">

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Request history" styleClass="h1" />
                    <Label fx:id="lblSubtitle" text="Every fuel request, newest first." styleClass="subtitle" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Refresh" onAction="#handleRefresh" styleClass="ghost">
                    <graphic><FontIcon iconLiteral="mdi2r-refresh" /></graphic>
                </Button>
            </HBox>

            <VBox styleClass="card" VBox.vgrow="ALWAYS" style="-fx-padding: 16 6 6 6;">
                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 10 4 10;">
                    <HBox styleClass="input-group" HBox.hgrow="ALWAYS" maxWidth="440">
                        <FontIcon iconLiteral="mdi2m-magnify" />
                        <TextField fx:id="searchField" promptText="Search customer, vehicle or registration" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <ComboBox fx:id="cbStatus" prefWidth="170" maxWidth="170" />
                </HBox>

                <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="idColumn" text="#" prefWidth="50" minWidth="46" maxWidth="70" />
                        <TableColumn fx:id="customerColumn" text="Customer" prefWidth="140" minWidth="110" />
                        <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="110" minWidth="100" />
                        <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="200" minWidth="120" />
                        <TableColumn fx:id="fuelColumn" text="Fuel" prefWidth="70" minWidth="66" />
                        <TableColumn fx:id="amountColumn" text="Litres" prefWidth="64" minWidth="60" />
                        <TableColumn fx:id="totalColumn" text="Total" prefWidth="100" minWidth="92" />
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="104" minWidth="100" />
                        <TableColumn fx:id="dateColumn" text="Requested" prefWidth="150" minWidth="140" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
