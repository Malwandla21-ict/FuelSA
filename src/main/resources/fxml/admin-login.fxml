<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.controllers.AdminLoginController"
      stylesheets="@../css/styles.css">

    <!-- Dark brand panel marks this as the admin area -->
    <VBox styleClass="brand-panel, dark" minWidth="440" prefWidth="460" maxWidth="460">
        <HBox alignment="CENTER_LEFT" spacing="14">
            <StackPane styleClass="brand-mark">
                <FontIcon iconLiteral="mdi2s-shield-account-outline" />
            </StackPane>
            <Label text="FuelSA Admin" styleClass="brand-name" />
        </HBox>

        <Region VBox.vgrow="ALWAYS" />

        <VBox spacing="14">
            <Label text="Admin console" styleClass="brand-headline" wrapText="true" />
            <Label text="Review fuel requests, approve deliveries and keep an eye on revenue."
                   styleClass="brand-tagline" wrapText="true" />
        </VBox>

        <VBox spacing="16">
            <Label text="Approve or reject requests in one click" styleClass="brand-feature">
                <graphic><FontIcon iconLiteral="mdi2c-check-decagram" /></graphic>
            </Label>
            <Label text="Full history with search and filters" styleClass="brand-feature">
                <graphic><FontIcon iconLiteral="mdi2h-history" /></graphic>
            </Label>
            <Label text="Revenue and profit analytics" styleClass="brand-feature">
                <graphic><FontIcon iconLiteral="mdi2c-chart-box-outline" /></graphic>
            </Label>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <Label text="Authorised staff only" styleClass="brand-footer" />
    </VBox>

    <StackPane styleClass="auth-side" HBox.hgrow="ALWAYS">
        <VBox styleClass="auth-form" maxWidth="380" alignment="CENTER_LEFT">

            <VBox spacing="6">
                <Label text="Admin sign in" styleClass="h1" />
                <Label text="Use your administrator account." styleClass="subtitle" wrapText="true" />
            </VBox>

            <VBox spacing="6">
                <Label text="Username" styleClass="field-label" />
                <HBox styleClass="input-group">
                    <FontIcon iconLiteral="mdi2a-account-tie-outline" />
                    <TextField fx:id="usernameField" promptText="Admin username" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="field-label" />
                <HBox styleClass="input-group">
                    <FontIcon iconLiteral="mdi2l-lock-outline" />
                    <PasswordField fx:id="passwordField" promptText="Admin password" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <Label fx:id="statusLabel" visible="false" managed="false" />

            <Button fx:id="loginButton" text="Sign in" onAction="#handleLogin" defaultButton="true" styleClass="primary, block" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="mdi2l-login" /></graphic>
            </Button>

            <HBox alignment="CENTER">
                <Hyperlink text="Back to customer sign in" onAction="#handleBack" styleClass="link">
                    <graphic><FontIcon iconLiteral="mdi2a-arrow-left" /></graphic>
                </Hyperlink>
            </HBox>
        </VBox>
    </StackPane>
</HBox>
